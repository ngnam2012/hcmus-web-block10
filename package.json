{
  "name": "shoplite-mfe-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ShopLite Polyglot Micro-Frontend Architecture (Shell Vanilla TS + React 18 + Vue 3 + Svelte 4 + Web Components Shadow DOM)",
  "type": "module",
  "workspaces": [
    "shell",
    "remotes/*"
  ],
  "scripts": {
    "build:remotes": "node scripts/build-all.mjs --remotes-only",
    "build": "node scripts/build-all.mjs",
    "build:vercel": "node scripts/build-all.mjs --vercel",
    "gate": "node scripts/compatibility-gate.mjs",
    "start": "node scripts/start-all.mjs",
    "dev": "node scripts/build-all.mjs && node scripts/start-all.mjs",
    "verify": "node scripts/verify-all.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "deploy": "node scripts/deploy.mjs",
    "build:remote": "node scripts/build-all.mjs",
    "check": "npm run typecheck && npm run gate",
    "verify:http": "node scripts/verify-e2e.mjs",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "devDependencies": {
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.2.1",
    "semver": "^7.8.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^3.3.14"
  }
}
